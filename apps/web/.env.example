# Адрес Strapi (без слэша в конце)
STRAPI_URL=http://localhost:1337
# Публичный адрес Strapi для формы заявки в браузере
PUBLIC_STRAPI_URL=http://localhost:1337
# API-токен Strapi только на чтение (Settings → API Tokens)
STRAPI_TOKEN=
# Адрес сайта для sitemap и canonical
SITE_URL=https://bredih.in
# Подтверждение прав в Яндекс Вебмастере и Google Search Console (только код из meta-тега)
PUBLIC_YANDEX_VERIFICATION=
PUBLIC_GOOGLE_VERIFICATION=
# Номер счётчика Яндекс Метрики
PUBLIC_YANDEX_METRIKA_ID=
