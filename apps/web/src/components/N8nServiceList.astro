---
// Услуги n8n строками-индексом, как основной список услуг.
import type { N8nService } from '../lib/types';
import { N8N_PATH, formatDuration, formatPrice } from '../lib/n8n';
interface Props { services: N8nService[]; heading?: 'h3' | 'h4' }
const { services, heading: H = 'h3' } = Astro.props;
---
<ul class="border-t-[1.5px] border-ink">
  {services.map((s) => (
    <li class="border-b-[1.5px] border-wire">
      <a href={`${N8N_PATH}${s.slug}/`} class="group grid gap-x-8 gap-y-2 py-5 sm:py-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)_10rem] md:items-baseline">
        <H class="text-[1.15rem] font-medium group-hover:text-signal-deep sm:text-[1.3rem]">{s.title}</H>
        <p class="text-[0.9375rem] text-ink-soft sm:text-base">{s.short}</p>
        <p class="text-[0.9375rem] md:text-right">
          {formatPrice(s) && <span class="font-semibold text-ink">{formatPrice(s)}</span>}
          {formatDuration(s.duration) && <span class="ml-3 text-ink-soft md:ml-0 md:block">{formatDuration(s.duration)}</span>}
        </p>
      </a>
    </li>
  ))}
</ul>
