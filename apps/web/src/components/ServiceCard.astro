---
import type { Service } from '../lib/types';
interface Props { service: Service }
const { service: s } = Astro.props;
---
<a href={`/services/${s.slug}/`} class="card group flex flex-col">
  <span class="text-3xl" aria-hidden="true">{s.icon}</span>
  <h3 class="mt-4 group-hover:text-brand-600">{s.title}</h3>
  <p class="mt-2 flex-1 text-muted">{s.short}</p>
  {s.priceFrom && <p class="mt-4 font-semibold">{s.priceFrom}</p>}
</a>
