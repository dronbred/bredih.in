---
// Живая схема автоматизации на первом экране: шаги выполняются по очереди, как сценарий.
// Сценарии берутся из Strapi («Сценарий на главной»). В HTML попадают все,
// а при каждой загрузке страницы браузер показывает один случайный.
import { getFlowScenarios } from '../lib/strapi';

const scenarios = await getFlowScenarios();
---
<figure class="flow" aria-label={`Пример автоматизации: ${scenarios[0].title}`}>
  {scenarios.map((sc, n) => (
    <div class="flow-scene" data-label={sc.title} hidden={n !== 0}>
      <ol class="flow-list">
        {sc.steps.map((s, i) => (
          <li class="flow-step" data-state="done">
            <span class="flow-node" aria-hidden="true"></span>
            <div class="min-w-0">
              <p class="flow-title">{s.title}</p>
              {s.detail && <p class="flow-detail">{s.detail}</p>}
            </div>
            {s.time && <time class="flow-time">{s.time}</time>}
          </li>
        ))}
      </ol>
      {sc.caption && <p class="flow-caption">{sc.caption}</p>}
    </div>
  ))}
</figure>
<script is:inline>
  // Выбираем сценарий сразу, ещё до отрисовки, чтобы не было мигания.
  (() => {
    const flow = document.currentScript.previousElementSibling;
    const scenes = flow.querySelectorAll('.flow-scene');
    const pick = Math.floor(Math.random() * scenes.length);
    scenes.forEach((el, k) => { el.hidden = k !== pick; });
    flow.setAttribute('aria-label', 'Пример автоматизации: ' + scenes[pick].dataset.label);
  })();
</script>

<style>
  .flow { position: relative; border-radius: 24px; background: var(--color-fog); padding: clamp(1.25rem, 0.8rem + 2vw, 2rem); }
  .flow-list { position: relative; display: grid; gap: 1.1rem; }
  .flow-list::before { content: ''; position: absolute; left: 0.6rem; top: 0.9rem; bottom: 0.9rem; width: 2px; background: var(--color-wire); }
  .flow-step { position: relative; display: grid; grid-template-columns: 1.25rem 1fr auto; gap: 0.9rem; align-items: start;
    padding: 0.85rem 1rem 0.85rem 0; transition: opacity .35s ease; }
  .flow-node { position: relative; z-index: 1; margin-top: 0.35rem; width: 1.25rem; height: 1.25rem; border-radius: 50%;
    background: var(--color-paper); border: 2px solid var(--color-wire); transition: background-color .3s, border-color .3s, box-shadow .3s; }
  .flow-title { font-weight: 600; line-height: 1.35; }
  .flow-detail { margin-top: 0.15rem; font-size: 0.9375rem; color: var(--color-ink-soft); line-height: 1.4; }
  .flow-time { margin-top: 0.2rem; font-size: 0.8125rem; color: var(--color-ink-soft); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .flow-caption { margin-top: 1.25rem; padding-top: 1rem; border-top: 1.5px solid var(--color-wire); font-size: 0.9375rem; color: var(--color-ink-soft);
    transition: opacity .4s; }

  /* Состояния шага: выполнен, выполняется, ждёт своей очереди */
  .flow-step[data-state='wait'] { opacity: 0.35; }
  .flow-step[data-state='done'] .flow-node { background: var(--color-done); border-color: var(--color-done); }
  .flow-step[data-state='active'] .flow-node { border-color: var(--color-signal); box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-signal) 22%, transparent); }
  /* Подпись появляется, когда сценарий дошёл до конца */
  .flow[data-running] .flow-caption { opacity: 0; }
</style>

<script>
  const flow = document.querySelector<HTMLElement>('.flow');
  const scene = flow?.querySelector<HTMLElement>('.flow-scene:not([hidden])');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (flow && scene && !reduce) {
    const steps = [...scene.querySelectorAll<HTMLElement>('.flow-step')];
    const total = steps.length;
    // step = сколько шагов уже выполнено; при step === total сценарий завершён
    const render = (step: number) => {
      steps.forEach((el, i) => { el.dataset.state = i < step ? 'done' : i === step ? 'active' : 'wait'; });
      if (step < total) flow.dataset.running = ''; else delete flow.dataset.running;
    };
    let step = 0;
    let timer = 0;
    const tick = () => {
      render(step);
      const delay = step === total ? 4200 : step === 0 ? 900 : 1100;
      step = step === total ? 0 : step + 1;
      timer = window.setTimeout(tick, delay);
    };
    // Запускаем, только когда схема видна, и останавливаем, когда уходит с экрана
    new IntersectionObserver(([e]) => {
      clearTimeout(timer);
      if (e.isIntersecting) { step = 0; tick(); } else { render(total); }
    }).observe(flow);
  }
</script>
