---
// Живая схема автоматизации на первом экране: шаги выполняются по очереди, как сценарий.
const steps = [
  { title: 'Новая заявка в Telegram-боте', detail: 'Ирина, ремонт кухни, бюджет до 400 000 ₽', time: '10:42:01' },
  { title: 'Сделка создана в CRM', detail: 'Сделка № 1842, этап «Новая заявка»', time: '10:42:02' },
  { title: 'Строка добавлена в отчёт', detail: 'Google Таблица «Заявки, ноябрь», источник: бот', time: '10:42:03' },
  { title: 'Менеджер получил задачу', detail: 'Перезвонить Ирине до 11:00', time: '10:42:04' },
];
---
<figure class="flow" data-step="4" aria-label="Пример автоматизации: заявка из Telegram-бота сама попадает в CRM, отчёт и задачу менеджеру">
  <ol class="flow-list">
    {steps.map((s, i) => (
      <li class="flow-step" style={`--i:${i}`}>
        <span class="flow-node" aria-hidden="true"></span>
        <div class="min-w-0">
          <p class="flow-title">{s.title}</p>
          <p class="flow-detail">{s.detail}</p>
        </div>
        <time class="flow-time">{s.time}</time>
      </li>
    ))}
  </ol>
  <figcaption class="flow-caption">Четыре действия за четыре секунды. Никто из сотрудников ничего не копировал.</figcaption>
</figure>

<style>
  .flow { position: relative; border-radius: 24px; background: var(--color-fog); padding: clamp(1.25rem, 0.8rem + 2vw, 2rem); }
  .flow-list { position: relative; display: grid; gap: 1.1rem; }
  .flow-list::before { content: ''; position: absolute; left: 0.6rem; top: 0.9rem; bottom: 0.9rem; width: 2px; background: var(--color-wire); }
  .flow-step { position: relative; display: grid; grid-template-columns: 1.25rem 1fr auto; gap: 0.9rem; align-items: start;
    padding: 0.85rem 1rem 0.85rem 0; transition: opacity .35s ease; }
  .flow-node { position: relative; z-index: 1; margin-top: 0.35rem; width: 1.25rem; height: 1.25rem; border-radius: 50%;
    background: var(--color-paper); border: 2px solid var(--color-wire); transition: background-color .3s, border-color .3s, box-shadow .3s; }
  .flow-title { font-weight: 600; line-height: 1.35; }
  .flow-detail { margin-top: 0.15rem; font-size: 0.9375rem; color: var(--color-ink-soft); line-height: 1.4; }
  .flow-time { margin-top: 0.2rem; font-size: 0.8125rem; color: var(--color-ink-soft); font-variant-numeric: tabular-nums; }
  .flow-caption { margin-top: 1.25rem; padding-top: 1rem; border-top: 1.5px solid var(--color-wire); font-size: 0.9375rem; color: var(--color-ink-soft); }

  /* Состояния: шаги до текущего выполнены, текущий активен, следующие ждут */
  .flow-step { opacity: var(--o, 1); }
  .flow[data-step='0'] .flow-step:nth-child(n+1),
  .flow[data-step='1'] .flow-step:nth-child(n+2),
  .flow[data-step='2'] .flow-step:nth-child(n+3),
  .flow[data-step='3'] .flow-step:nth-child(n+4) { --o: 0.35; }
  .flow[data-step='1'] .flow-step:nth-child(-n+1) .flow-node,
  .flow[data-step='2'] .flow-step:nth-child(-n+2) .flow-node,
  .flow[data-step='3'] .flow-step:nth-child(-n+3) .flow-node,
  .flow[data-step='4'] .flow-step .flow-node { background: var(--color-done); border-color: var(--color-done); }
  .flow[data-step='0'] .flow-step:nth-child(1) .flow-node,
  .flow[data-step='1'] .flow-step:nth-child(2) .flow-node,
  .flow[data-step='2'] .flow-step:nth-child(3) .flow-node,
  .flow[data-step='3'] .flow-step:nth-child(4) .flow-node { border-color: var(--color-signal); box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-signal) 22%, transparent); }
  .flow-caption { transition: opacity .4s; }
  .flow:not([data-step='4']) .flow-caption { opacity: 0; }
</style>

<script>
  const flow = document.querySelector<HTMLElement>('.flow');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (flow && !reduce) {
    let step = 0;
    const tick = () => {
      flow.dataset.step = String(step);
      const delay = step === 4 ? 4200 : step === 0 ? 900 : 1100;
      step = step === 4 ? 0 : step + 1;
      timer = window.setTimeout(tick, delay);
    };
    let timer = 0;
    // Запускаем, только когда схема видна, и останавливаем, когда уходит с экрана
    new IntersectionObserver(([e]) => {
      clearTimeout(timer);
      if (e.isIntersecting) { step = 0; tick(); } else { flow.dataset.step = '4'; }
    }).observe(flow);
  }
</script>
