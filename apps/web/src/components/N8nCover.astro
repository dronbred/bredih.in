---
// Обложка услуги n8n. Если в Strapi загружена картинка, показываем её,
// иначе рисуем схему сценария из поля flow: откуда данные, что делает n8n, что получается.
import type { N8nService } from '../lib/types';
import { mediaUrl } from '../lib/strapi';
interface Props { service: N8nService; size?: 'card' | 'hero'; eager?: boolean }
const { service: s, size = 'card', eager = false } = Astro.props;
const img = mediaUrl(s.cover?.url);
const flow = (s.flow ?? []).slice(0, 4);

// Иконки 24×24, обводка. Ключи используются в поле flow.
const icons: Record<string, string> = {
  form: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8.5 8h7M8.5 12h7M8.5 16h4"/>',
  crm: '<circle cx="9" cy="8" r="3"/><path d="M3.5 20c0-3 2.5-5.5 5.5-5.5s5.5 2.5 5.5 5.5"/><circle cx="17" cy="9" r="2.3"/><path d="M16 14.6c2.6.3 4.5 2.5 4.5 5.4"/>',
  telegram: '<path d="M21 4 3 11.2l6 2.3L11.3 20l3.2-4.3 5 3.6z"/><path d="M9 13.5 21 4"/>',
  table: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M3 15h18M9 4v16"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  server: '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
  shield: '<path d="M12 3 20 6v6c0 4.4-3.4 7.9-8 9-4.6-1.1-8-4.6-8-9V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  ai: '<path d="M12 3.5 13.9 9l5.6 1.9-5.6 1.9L12 18.5l-1.9-5.7-5.6-1.9L10.1 9z"/><path d="M19 15.5l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/>',
  box: '<path d="m3 7.5 9-4.5 9 4.5v9L12 21l-9-4.5z"/><path d="m3 7.5 9 4.5 9-4.5M12 12v9"/>',
  cart: '<path d="M3 4h2.2l2.3 11h11L21 7.5H6.4"/><circle cx="9" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/>',
  chart: '<path d="M3 20h18M6 20v-7M11 20V6M16 20v-10M21 20V9" />',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/>',
  bot: '<rect x="4.5" y="8" width="15" height="11" rx="3"/><path d="M12 4.5V8"/><circle cx="12" cy="4" r="1"/><path d="M9.5 13.5h.01M14.5 13.5h.01"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20.5 20.5-4.5-4.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  refresh: '<path d="M4.5 10a8 8 0 0 1 14.2-3.2L20 8.5M20 4v4.5h-4.5"/><path d="M19.5 14a8 8 0 0 1-14.2 3.2L4 15.5M4 20v-4.5h4.5"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7"/>',
};
const tone = (i: number) => (i === flow.length - 1 ? 'done' : i === 0 ? 'signal' : 'ink');
---
{img ? (
  <img src={img} alt={s.cover?.alternativeText || s.title} width={s.cover?.width} height={s.cover?.height}
       loading={eager ? 'eager' : 'lazy'} decoding="async"
       class={`cover cover-${size} w-full object-cover`} />
) : flow.length > 0 ? (
  <div class={`cover cover-${size}`} role="img" aria-label={`Схема: ${flow.map((f) => f.label).join(', затем ')}`}>
    <ol class="cover-flow">
      {flow.map((f, i) => (
        <li class={`cover-step tone-${tone(i)}`}>
          <span class="cover-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[f.icon] ?? icons.code} />
          </span>
          <span class="cover-label">{f.label}</span>
        </li>
      ))}
    </ol>
    <span class="cover-tag" aria-hidden="true">n8n</span>
  </div>
) : null}

<style>
  .cover { position: relative; aspect-ratio: 16 / 10; border-radius: 20px; background: var(--color-fog); overflow: hidden; }
  .cover-hero { border-radius: 24px; }
  div.cover { display: grid; place-items: center; padding: 1.25rem 1.5rem;
    background-image: radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--color-wire) 70%, transparent) 1px, transparent 0);
    background-size: 18px 18px; }
  .cover-flow { position: relative; display: grid; gap: 0.7rem; width: 100%; max-width: 17rem; }
  .cover-hero .cover-flow { gap: 1rem; max-width: 20rem; }
  .cover-step { position: relative; display: flex; align-items: center; gap: 0.75rem; padding: 0.4rem 0.9rem 0.4rem 0.4rem;
    border-radius: 999px; background: var(--color-paper); box-shadow: 0 1px 0 var(--color-wire); }
  .cover-step:nth-child(2) { margin-left: 1.25rem; }
  .cover-step:nth-child(3) { margin-left: 2.5rem; }
  .cover-step:nth-child(4) { margin-left: 3.75rem; }
  .cover-icon { display: grid; place-items: center; flex: none; width: 2.4rem; height: 2.4rem; border-radius: 50%; color: #fff; }
  .cover-icon svg { width: 1.3rem; height: 1.3rem; }
  .tone-signal .cover-icon { background: var(--color-signal); }
  .tone-ink .cover-icon { background: var(--color-ink); }
  .tone-done .cover-icon { background: var(--color-done); }
  .cover-label { min-width: 0; font-size: 0.875rem; font-weight: 600; line-height: 1.25; color: var(--color-ink); }
  .cover-hero .cover-label { font-size: 0.9375rem; }
  .cover-tag { position: absolute; right: 0.9rem; top: 0.75rem; font-family: var(--font-display); font-size: 0.75rem; font-weight: 600; color: var(--color-ink-soft); }
</style>
