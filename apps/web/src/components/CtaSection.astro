---
import ContactForm from './ContactForm.astro';
import { getServices } from '../lib/strapi';
interface Props { selected?: string; title?: string }
const { selected, title = 'Расскажите о задаче' } = Astro.props;
const services = await getServices();
---
<section id="contact" class="section bg-surface">
  <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:items-start">
    <div>
      <p class="eyebrow">Заявка</p>
      <h2 class="mt-3">{title}</h2>
      <p class="mt-4 text-lg text-muted">Отвечу в течение дня, предложу решение и примерную оценку. Консультация бесплатная.</p>
    </div>
    <ContactForm services={services} selected={selected} />
  </div>
</section>
