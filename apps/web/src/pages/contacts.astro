---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { getGlobal, getServices } from '../lib/strapi';
import { breadcrumbs, ids } from '../lib/schema';
const [g, services] = await Promise.all([getGlobal(), getServices()]);
const schema = [{ '@type': 'ContactPage', name: 'Контакты', about: { '@id': ids.business } }, breadcrumbs([{ name: 'Контакты', path: '/contacts/' }])];
---
<Base title="Контакты" description="Как связаться с Андреем Бредихиным: Telegram, почта и форма заявки. Ответ в течение рабочего дня." schema={schema}>
  <section class="section-y bg-ink text-white">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.35fr]">
      <div>
        <h1>Контакты</h1>
        <p class="mt-6 max-w-md text-lg text-white/70">Быстрее всего отвечаю в Telegram. Если удобнее, оставьте заявку, и я свяжусь с вами сам.</p>
        <a href={g.telegram} target="_blank" rel="noopener" class="btn-light mt-8">Написать в Telegram</a>
        <ul class="mt-10 grid gap-2 text-white/80">
          <li><a href={`mailto:${g.email}`} class="hover:text-white">{g.email}</a></li>
          {g.phone && <li><a href={`tel:${g.phone.replace(/[^+\d]/g, '')}`} class="hover:text-white">{g.phone}</a></li>}
        </ul>
      </div>
      <ContactForm services={services} />
    </div>
  </section>
</Base>
