---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { getGlobal, getServices } from '../lib/strapi';
const [g, services] = await Promise.all([getGlobal(), getServices()]);
---
<Base title="Контакты">
  <section class="section">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <h1>Контакты</h1>
        <p class="mt-6 text-lg text-muted">Быстрее всего ответ в Telegram. Можно оставить заявку через форму, я свяжусь удобным для вас способом.</p>
        <ul class="mt-8 grid gap-3 text-lg">
          <li><a href={g.telegram} target="_blank" rel="noopener" class="font-semibold text-brand-600">Telegram</a></li>
          <li><a href={`mailto:${g.email}`} class="hover:text-brand-600">{g.email}</a></li>
          {g.phone && <li><a href={`tel:${g.phone.replace(/[^+\d]/g, '')}`}>{g.phone}</a></li>}
        </ul>
      </div>
      <ContactForm services={services} />
    </div>
  </section>
</Base>
