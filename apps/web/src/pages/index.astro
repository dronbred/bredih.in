---
import Base from '../layouts/Base.astro';
import AutomationFlow from '../components/AutomationFlow.astro';
import ServiceList from '../components/ServiceList.astro';
import CaseCard from '../components/CaseCard.astro';
import CtaSection from '../components/CtaSection.astro';
import { getCases, getGlobal, getHome, getServices, getTestimonials } from '../lib/strapi';

const [g, home, services, cases, testimonials] = await Promise.all([getGlobal(), getHome(), getServices(), getCases(), getTestimonials()]);
const featured = cases.filter((c) => c.featured).slice(0, 3);
---
<Base>
  <section class="container-x grid items-center gap-10 pb-14 pt-10 sm:pt-14 lg:grid-cols-[1.15fr_1fr] lg:gap-14 lg:pb-24 lg:pt-20">
    <div>
      <h1 class="max-w-[14ch] lg:max-w-none">{home.heroTitle}</h1>
      <p class="lede measure mt-6">{home.heroText}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={g.telegram} target="_blank" rel="noopener" class="btn-primary">{home.heroCta}</a>
        <a href="#contact" class="btn-quiet">Оставить заявку</a>
      </div>
    </div>
    <AutomationFlow />
  </section>

  <section class="section-y pt-0">
    <div class="container-x">
      <div class="mb-8 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
        <h2>Чем могу помочь</h2>
        <a href="/services/" class="link font-medium">Подробнее об услугах</a>
      </div>
      <ServiceList services={services} />
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section-y pt-0">
      <div class="container-x">
        <div class="mb-8 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
          <h2>Что уже работает у клиентов</h2>
          <a href="/cases/" class="link font-medium">Все кейсы</a>
        </div>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {featured.map((c) => <CaseCard item={c} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section-y border-t-[1.5px] border-wire">
    <div class="container-x">
      <h2>Как проходит работа</h2>
      <ol class="steps mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        {home.steps.map((s, i) => (
          <li class="relative">
            <span class="relative z-[1] grid size-10 place-items-center rounded-full border-[1.5px] border-ink bg-paper font-display text-sm font-semibold">{i + 1}</span>
            <h3 class="mt-5">{s.title}</h3>
            <p class="mt-2 text-[0.9375rem] text-ink-soft">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="section-y bg-fog">
      <div class="container-x">
        <h2>Отзывы</h2>
        <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {testimonials.map((t) => (
            <figure class="rounded-3xl bg-paper p-6">
              <blockquote class="text-lg">«{t.text}»</blockquote>
              <figcaption class="mt-4 text-[0.9375rem]"><b>{t.author}</b>{t.role && <span class="block text-ink-soft">{t.role}</span>}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-y pt-0">
    <div class="container-x grid gap-6 lg:grid-cols-[1fr_1.35fr]">
      <h2>Инструменты</h2>
      <div>
        <p class="lede">Подбираю под задачу, а не под привычку. Чаще всего работаю с этим:</p>
        <p class="mt-4 font-display text-lg leading-relaxed sm:text-xl">{home.technologies.join(', ')}.</p>
      </div>
    </div>
  </section>

  <CtaSection />
</Base>

<style>
  @media (width >= 64rem) {
    .steps li:not(:last-child)::after { content: ''; position: absolute; top: 1.2rem; left: 2.5rem; right: -1.5rem; height: 1.5px; background: var(--color-wire); }
  }
</style>
