---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CaseCard from '../components/CaseCard.astro';
import CtaSection from '../components/CtaSection.astro';
import { getCases, getHome, getServices, getTestimonials } from '../lib/strapi';

const [home, services, cases, testimonials] = await Promise.all([getHome(), getServices(), getCases(), getTestimonials()]);
const featured = cases.filter((c) => c.featured).slice(0, 3);
---
<Base>
  <section class="section relative overflow-hidden">
    <div class="pointer-events-none absolute -top-40 right-[-10%] size-[36rem] rounded-full bg-brand-100 blur-3xl" aria-hidden="true"></div>
    <div class="container-x relative">
      <p class="eyebrow">Автоматизация · Сайты · Боты · Приложения</p>
      <h1 class="mt-4 max-w-4xl">{home.heroTitle}</h1>
      <p class="mt-6 max-w-2xl text-lg text-muted sm:text-xl">{home.heroText}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#contact" class="btn-primary">{home.heroCta}</a>
        <a href="/cases/" class="btn-ghost">Смотреть кейсы</a>
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container-x">
      <p class="eyebrow">Услуги</p>
      <h2 class="mt-3">Чем могу помочь</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section bg-surface">
      <div class="container-x">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div><p class="eyebrow">Кейсы</p><h2 class="mt-3">Что уже сделано</h2></div>
          <a href="/cases/" class="font-semibold text-brand-600">Все кейсы →</a>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {featured.map((c) => <CaseCard item={c} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container-x">
      <p class="eyebrow">Процесс</p>
      <h2 class="mt-3">Как я работаю</h2>
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {home.steps.map((s, i) => (
          <li class="rounded-2xl border border-line p-6">
            <span class="text-sm font-bold text-brand-600">0{i + 1}</span>
            <h3 class="mt-3">{s.title}</h3>
            <p class="mt-2 text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="section bg-surface">
      <div class="container-x">
        <p class="eyebrow">Отзывы</p>
        <h2 class="mt-3">Что говорят клиенты</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {testimonials.map((t) => (
            <figure class="rounded-2xl bg-white p-6">
              <blockquote class="text-lg">«{t.text}»</blockquote>
              <figcaption class="mt-4"><b>{t.author}</b>{t.role && <span class="block text-sm text-muted">{t.role}</span>}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container-x">
      <p class="eyebrow">Технологии</p>
      <h2 class="mt-3">Инструменты, с которыми работаю</h2>
      <ul class="mt-8 flex flex-wrap gap-3">
        {home.technologies.map((t) => <li class="rounded-full border border-line px-4 py-2 font-medium">{t}</li>)}
      </ul>
    </div>
  </section>

  <CtaSection />
</Base>
