---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getCases, getServices } from '../../lib/strapi';
const [cases, services] = await Promise.all([getCases(), getServices()]);
---
<Base title="Кейсы" description="Примеры проектов: автоматизация, сайты, Telegram-боты и приложения.">
  <section class="section">
    <div class="container-x">
      <p class="eyebrow">Кейсы</p>
      <h1 class="mt-3">Проекты и результаты</h1>
      <div class="mt-8 flex gap-2 overflow-x-auto pb-2" role="group" aria-label="Фильтр по услуге">
        <button class="filter btn-ghost !min-h-10 shrink-0 !py-2" data-filter="" aria-pressed="true">Все</button>
        {services.map((s) => <button class="filter btn-ghost !min-h-10 shrink-0 !py-2" data-filter={s.slug} aria-pressed="false">{s.title}</button>)}
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {cases.map((c) => <div data-services={(c.services ?? []).map((x) => x.slug).join(' ')}><CaseCard item={c} /></div>)}
      </div>
    </div>
  </section>
  <CtaSection />
</Base>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filter ?? '';
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-services]').forEach((el) => {
      el.hidden = !!f && !el.dataset.services!.split(' ').includes(f);
    });
  }));
</script>
<style>
  .filter[aria-pressed='true'] { background: var(--color-brand-600); border-color: var(--color-brand-600); color: #fff; }
</style>
