---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import CtaSection from '../../components/CtaSection.astro';
import N8nTeaser from '../../components/N8nTeaser.astro';
import { N8N_PARENT_SLUG } from '../../lib/n8n';
import { getCases, getServices } from '../../lib/strapi';
import type { Service } from '../../lib/types';
import { breadcrumbs, faqPage, serviceSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service: s } = Astro.props as { service: Service };
const related = s.cases?.length ? s.cases : (await getCases()).filter((c) => c.services?.some((x) => x.slug === s.slug));
const schema = [serviceSchema(s), breadcrumbs([{ name: 'Услуги', path: '/services/' }, { name: s.title, path: `/services/${s.slug}/` }]), ...(s.faq?.length ? [faqPage(s.faq)] : [])];
---
<Base title={s.seo?.metaTitle ?? s.title} description={s.seo?.metaDescription ?? s.short} schema={schema}>
  <section class="section-y">
    <div class="container-x">
      <nav aria-label="Навигация"><a href="/services/" class="text-[0.9375rem] text-ink-soft hover:text-ink">Услуги</a></nav>
      <div class="mt-4 grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:items-end">
        <div>
          <h1>{s.title}</h1>
          <p class="lede measure mt-6">{s.description ?? s.short}</p>
        </div>
        {(s.priceFrom || s.duration) && (
          <dl class="grid grid-cols-2 gap-6 border-t-[1.5px] border-ink pt-5 lg:grid-cols-1">
            {s.priceFrom && <div><dt class="text-[0.9375rem] text-ink-soft">Стоимость</dt><dd class="font-display text-2xl font-semibold">{s.priceFrom}</dd></div>}
            {s.duration && <div><dt class="text-[0.9375rem] text-ink-soft">Срок</dt><dd class="font-display text-2xl font-semibold">{s.duration}</dd></div>}
          </dl>
        )}
      </div>
    </div>
  </section>

  {(s.features?.length ?? 0) > 0 && (
    <section class="section-y pt-0">
      <div class="container-x grid gap-8 lg:grid-cols-[1fr_1.5fr]">
        <h2>Что входит</h2>
        <ul class="grid gap-x-8 sm:grid-cols-2">
          {s.features!.map((f) => (
            <li class="flex gap-3 border-b-[1.5px] border-wire py-4">
              <svg class="mt-1 shrink-0 text-done" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3.5 9.5l3.5 3.5 7.5-8" /></svg>
              <span><b class="font-semibold">{f.title}</b>{f.text && <span class="mt-1 block text-ink-soft">{f.text}</span>}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {s.slug === N8N_PARENT_SLUG && (
    <section class="section-y pt-0">
      <div class="container-x"><N8nTeaser /></div>
    </section>
  )}

  {related.length > 0 && (
    <section class="section-y pt-0">
      <div class="container-x">
        <h2>Примеры</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">{related.map((c) => <CaseCard item={c} />)}</div>
      </div>
    </section>
  )}

  {(s.faq?.length ?? 0) > 0 && (
    <section class="section-y pt-0">
      <div class="container-x grid gap-8 lg:grid-cols-[1fr_1.5fr]">
        <h2>Частые вопросы</h2>
        <div class="border-t-[1.5px] border-ink">
          {s.faq!.map((q) => (
            <details class="group border-b-[1.5px] border-wire">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-semibold">
                {q.question}
                <svg class="shrink-0 transition-transform group-open:rotate-45" width="18" height="18" viewBox="0 0 18 18" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 3v12M3 9h12" /></svg>
              </summary>
              <p class="measure pb-5 text-ink-soft">{q.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaSection selected={s.slug} title="Обсудим вашу задачу" />
</Base>
