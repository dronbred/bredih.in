---
import Base from '../../layouts/Base.astro';
import ServiceList from '../../components/ServiceList.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getServices } from '../../lib/strapi';
const services = await getServices();
---
<Base title="Услуги" description="Автоматизация процессов, разработка сайтов, Telegram-ботов и приложений.">
  <section class="section-y">
    <div class="container-x">
      <h1 class="max-w-[18ch]">Услуги</h1>
      <p class="lede measure mt-6">Беру задачу целиком: разбираюсь в процессе, предлагаю решение, делаю и поддерживаю. Цена «от» указана для небольшой задачи, точную назову после созвона.</p>
      <div class="mt-12"><ServiceList services={services} /></div>
    </div>
  </section>
  <CtaSection />
</Base>
