---
import Base from '../../../layouts/Base.astro';
import N8nServiceList from '../../../components/N8nServiceList.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { getN8nPage, getN8nServices } from '../../../lib/strapi';
import { N8N_PARENT_SLUG, N8N_PATH, groupByCategory } from '../../../lib/n8n';
import { abs, breadcrumbs, faqPage, ids } from '../../../lib/schema';

const [page, services] = await Promise.all([getN8nPage(), getN8nServices()]);
const groups = groupByCategory(services);
const prices = services.map((s) => s.price).filter((p): p is number => p != null);
const days = services.map((s) => s.duration).filter((d): d is number => d != null);
const rub = new Intl.NumberFormat('ru-RU');
const facts = [
  { value: String(services.length), label: 'готовых услуг' },
  prices.length ? { value: `от ${rub.format(Math.min(...prices))} ₽`, label: 'стартовая цена' } : null,
  days.length ? { value: `от ${Math.min(...days)} ${Math.min(...days) % 10 === 1 && Math.min(...days) % 100 !== 11 ? 'дня' : 'дней'}`, label: 'срок запуска' } : null,
].filter(Boolean) as { value: string; label: string }[];

const schema = [
  breadcrumbs([{ name: 'Услуги', path: '/services/' }, { name: page.title, path: N8N_PATH }]),
  {
    '@type': 'OfferCatalog', '@id': abs(`${N8N_PATH}#catalog`), name: page.title, url: abs(N8N_PATH), provider: { '@id': ids.business },
    itemListElement: groups.map((g) => ({
      '@type': 'OfferCatalog', name: g.label,
      itemListElement: g.items.map((s) => ({
        '@type': 'Offer', url: abs(`${N8N_PATH}${s.slug}/`), priceCurrency: 'RUB',
        priceSpecification: s.price != null ? { '@type': 'PriceSpecification', minPrice: s.price, priceCurrency: 'RUB' } : undefined,
        itemOffered: { '@type': 'Service', name: s.title, description: s.short, url: abs(`${N8N_PATH}${s.slug}/`) },
      })),
    })),
  },
  ...(page.faq?.length ? [faqPage(page.faq)] : []),
];
---
<Base title={page.seo?.metaTitle ?? page.title} description={page.seo?.metaDescription ?? page.intro} schema={schema}>
  <section class="section-y pb-10 sm:pb-14">
    <div class="container-x">
      <nav aria-label="Навигация" class="text-[0.9375rem] text-ink-soft">
        <a href="/services/" class="hover:text-ink">Услуги</a>
      </nav>
      <div class="mt-4 grid gap-10 lg:grid-cols-[1.6fr_1fr] lg:items-end">
        <div>
          <h1 class="max-w-[20ch]">{page.title}</h1>
          {page.intro && <p class="lede measure mt-6">{page.intro}</p>}
        </div>
        <dl class="grid grid-cols-3 gap-4 border-t-[1.5px] border-ink pt-5 lg:grid-cols-1 lg:gap-5">
          {facts.map((f) => (
            <div>
              <dt class="sr-only">{f.label}</dt>
              <dd class="font-display text-xl font-semibold sm:text-2xl">{f.value}</dd>
              <dd class="text-[0.875rem] text-ink-soft sm:text-[0.9375rem]">{f.label}</dd>
            </div>
          ))}
        </dl>
      </div>

      {groups.length > 1 && (
        <nav aria-label="Категории услуг" class="-mx-4 mt-10 overflow-x-auto px-4 sm:mx-0 sm:px-0">
          <ul class="flex w-max gap-2 sm:w-auto sm:flex-wrap">
            {groups.map((g) => (
              <li><a href={`#${g.id}`} class="btn-quiet !min-h-10 !px-4 !py-2 whitespace-nowrap text-[0.9375rem]">{g.label}<span class="text-ink-soft">{g.items.length}</span></a></li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </section>

  <section class="pb-[clamp(3.5rem,2rem+5vw,6.5rem)]" aria-label="Список услуг">
    <div class="container-x grid gap-14 sm:gap-16">
      {groups.map((g) => (
        <div id={g.id} class="scroll-mt-24">
          <h2 class="text-[1.4rem] sm:text-[1.8rem]">{g.label}</h2>
          <div class="mt-6"><N8nServiceList services={g.items} /></div>
        </div>
      ))}
    </div>
  </section>

  {(page.benefits?.length ?? 0) > 0 && (
    <section class="section-y bg-fog">
      <div class="container-x">
        <h2 class="max-w-[22ch]">Почему n8n</h2>
        <ul class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
          {page.benefits!.map((b) => (
            <li class="border-t-[1.5px] border-ink pt-5">
              <h3>{b.title}</h3>
              {b.text && <p class="mt-2 text-[0.9375rem] text-ink-soft">{b.text}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {(page.steps?.length ?? 0) > 0 && (
    <section class="section-y">
      <div class="container-x">
        <h2>Как проходит работа</h2>
        <ol class="steps mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
          {page.steps!.map((s, i) => (
            <li class="relative">
              <span class="relative z-[1] grid size-10 place-items-center rounded-full border-[1.5px] border-ink bg-paper font-display text-sm font-semibold">{i + 1}</span>
              <h3 class="mt-5">{s.title}</h3>
              {s.text && <p class="mt-2 text-[0.9375rem] text-ink-soft">{s.text}</p>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {(page.faq?.length ?? 0) > 0 && (
    <section class="section-y pt-0">
      <div class="container-x grid gap-8 lg:grid-cols-[1fr_1.5fr]">
        <h2>Частые вопросы</h2>
        <div class="border-t-[1.5px] border-ink">
          {page.faq!.map((q) => (
            <details class="group border-b-[1.5px] border-wire">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-semibold">
                {q.question}
                <svg class="shrink-0 transition-transform group-open:rotate-45" width="18" height="18" viewBox="0 0 18 18" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 3v12M3 9h12" /></svg>
              </summary>
              <p class="measure pb-5 text-ink-soft">{q.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaSection selected={N8N_PARENT_SLUG} title="Не нашли свою задачу? Опишите её" />
</Base>

<style>
  @media (width >= 64rem) {
    .steps li:not(:last-child)::after { content: ''; position: absolute; top: 1.2rem; left: 2.5rem; right: -1.5rem; height: 1.5px; background: var(--color-wire); }
  }
</style>
