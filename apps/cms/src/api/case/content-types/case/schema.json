{
  "kind": "collectionType",
  "collectionName": "cases",
  "info": {
    "singularName": "case",
    "pluralName": "cases",
    "displayName": "Кейс",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "client": {
      "type": "string"
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "task": {
      "type": "text"
    },
    "solution": {
      "type": "text"
    },
    "result": {
      "type": "text"
    },
    "metrics": {
      "type": "component",
      "repeatable": true,
      "component": "shared.metric"
    },
    "stack": {
      "type": "json"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "link": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "services": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::service.service",
      "inversedBy": "cases"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
