{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Услуга",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "icon": {
      "type": "string"
    },
    "short": {
      "type": "text",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "shared.item"
    },
    "steps": {
      "type": "component",
      "repeatable": true,
      "component": "shared.item"
    },
    "priceFrom": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "faq": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq"
    },
    "cases": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::case.case",
      "mappedBy": "services"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
