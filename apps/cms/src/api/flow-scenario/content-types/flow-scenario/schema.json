{
  "kind": "collectionType",
  "collectionName": "flow_scenarios",
  "info": {
    "singularName": "flow-scenario",
    "pluralName": "flow-scenarios",
    "displayName": "Сценарий на главной",
    "description": "Живая схема автоматизации на первом экране. При каждой загрузке страницы показывается случайный опубликованный сценарий"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "steps": {
      "type": "component",
      "repeatable": true,
      "component": "shared.flow-step",
      "required": true,
      "min": 2,
      "max": 6
    },
    "caption": {
      "type": "string"
    }
  }
}
